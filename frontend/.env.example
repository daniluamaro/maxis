# Variáveis públicas do frontend, lidas pelo Vite no build (import.meta.env).
# Desenvolvimento: copiar para frontend/.env.local (fora do git) com os valores do projeto de DEV
# (`maxis`). Build de produção: os valores vêm das variables do environment `production` do GitHub.
# Só a chave publishable (sb_publishable_…); a secreta (sb_secret_…) nunca entra no frontend.
# O app passa a ler estas variáveis na Fase 2.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
