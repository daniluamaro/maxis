{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx",

    /* O app é empacotado pelo Vite */
    "module": "esnext",
    "moduleResolution": "bundler",

    /* Alias espelhado em vite.config.ts */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
