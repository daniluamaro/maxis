{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],

    /* vite.config.ts roda no Node: resolução de módulos do Node, não a do bundler */
    "module": "nodenext"
  },
  "include": ["vite.config.ts"]
}
