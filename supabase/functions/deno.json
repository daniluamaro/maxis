{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "eqeqeq",
        "no-non-null-assertion",
        "no-throw-literal",
        "no-eval",
        "no-self-compare",
        "default-param-last",
        "verbatim-module-syntax"
      ]
    }
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 100,
    "indentWidth": 2
  },
  "tasks": {
    "hash-senha-seed": "deno run --no-prompt --allow-read=../../.env.local _seed/hashDaSenha.ts",
    "integracao": "deno test --no-prompt -P=integracao _integracao/provisionarUsuario.integracao.ts"
  },
  "test": {
    "permissions": { "env": true }
  },
  "permissions": {
    "integracao": {
      "env": ["VITE_SUPABASE_URL", "VITE_SUPABASE_PUBLISHABLE_KEY", "SENHA_SEED_DEV"],
      "net": ["ddaqbcfrplzdywpgilbf.supabase.co"],
      "run": ["npx"]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@supabase/server": "npm:@supabase/server@1.9.2",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.119.2",
    "bcryptjs": "npm:bcryptjs@3.0.3",
    "zod": "npm:zod@4.6.7"
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  }
}
